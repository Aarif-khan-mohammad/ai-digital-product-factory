# ============================================================
# AI DIGITAL PRODUCT FACTORY — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── APPLICATION ─────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_SECRET=change-this-to-a-random-64-char-string
NODE_ENV=development

# ── DATABASE ────────────────────────────────────────────────
DATABASE_URL=postgresql://factory_user:factory_pass@localhost:5432/digital_factory
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_factory
DB_USER=factory_user
DB_PASSWORD=factory_pass
DB_SSL=false

# ── AUTHENTICATION ──────────────────────────────────────────
JWT_SECRET=change-this-to-another-random-64-char-string
JWT_EXPIRES_IN=7d

# ── AI PROVIDER — LEVEL 1: LOCAL (PREFERRED) ────────────────
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
IMAGE_MODEL=stable-diffusion

# ── AI PROVIDER — LEVEL 2: FREE CLOUD (OPTIONAL FALLBACK) ───
# Set AI_PROVIDER=cloudflare to use Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3-8b-instruct

# ── AI SAFETY LIMITS ────────────────────────────────────────
MAX_DAILY_AI_REQUESTS=200
MAX_DAILY_RESEARCH_JOBS=5
MAX_DAILY_PRODUCT_GENERATIONS=3
MAX_DAILY_PUBLISHES=10
MAX_STORAGE_GB=10
MAX_API_REQUESTS=1000

# ── AUTOMATION SETTINGS ─────────────────────────────────────
AUTO_RESEARCH=true
AUTO_CREATE=false
AUTO_QA=true
AUTO_PUBLISH=false
AUTO_PRICE=true
RESEARCH_CRON=0 6 * * *
MAX_PRODUCTS_PER_DAY=3
MAX_REVISIONS_PER_PRODUCT=3
MIN_OPPORTUNITY_SCORE=70
MIN_QA_SCORE=85

# ── N8N AUTOMATION ──────────────────────────────────────────
N8N_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_SECRET=change-this-webhook-secret

# ── FILE STORAGE ────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./products
# For S3-compatible (optional):
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ── PUBLISHING CHANNELS ─────────────────────────────────────
# Gumroad (free tier available)
GUMROAD_ACCESS_TOKEN=
GUMROAD_ENABLED=false

# Payhip (free tier available)
PAYHIP_API_KEY=
PAYHIP_ENABLED=false

# Own Store (always available)
OWN_STORE_ENABLED=true
OWN_STORE_URL=http://localhost:3000/store

# ── RESEARCH SOURCES ────────────────────────────────────────
# Reddit (public API, no auth required for read)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DigitalProductFactory/1.0

# ── NOTIFICATIONS ───────────────────────────────────────────
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL_TO=

NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_URL=

# ── FINANCIAL ───────────────────────────────────────────────
DEFAULT_CURRENCY=USD
DEFAULT_PRODUCT_PRICE=27.00

# ── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/app.log
